# Copiá este archivo como .env (o definí las variables en tu servidor).
PORT=3000
# 127.0.0.1 = solo esta computadora. Usá 0.0.0.0 para abrirlo a la red del aula.
HOST=127.0.0.1
ATTACKLAB_DB=data/attacklab.db
# Código que necesitan los alumnos para crear su cuenta.
ATTACKLAB_COURSE_CODE=ET20-6-4
# Usuarios de demostración (por defecto: activados en desarrollo, desactivados en producción).
ATTACKLAB_DEMO_USERS=true
# Docente inicial (recomendado en producción, en lugar de los usuarios demo).
ATTACKLAB_TEACHER_NAME=
ATTACKLAB_TEACHER_EMAIL=
ATTACKLAB_TEACHER_PASSWORD=
